{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Snapline",
  "version": "0.4.25",
  "identifier": "app.snapline.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data: blob:; media-src 'self' asset: http://asset.localhost blob:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost",
      "assetProtocol": { "enable": true, "scope": ["$APPLOCALDATA/library/**"] }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "category": "Utility",
    "shortDescription": "Screenshots, always within reach",
    "longDescription": "A private, local screenshot shelf for Windows. Built with Rust and Tauri.",
    "resources": {
      "../LICENSE": "LICENSE",
      "../README.md": "README.md",
      "../CONTRIBUTING.md": "CONTRIBUTING.md",
      "../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md",
      "../docs/": "docs/",
      "../licenses/": "licenses/"
    },
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"],
    "windows": { "nsis": { "displayLanguageSelector": true, "languages": ["SimpChinese", "English"], "installMode": "currentUser" } }
  }
}
